{
  "name": "qa-agent",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @qa-agent/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
