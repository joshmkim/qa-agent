# --- Server ---
PORT=3001
# Public base URL of this service (used for check run details_url links).
PUBLIC_URL=http://localhost:3001

# --- GitHub App ---
# Easiest: `pnpm --filter @qa-agent/control-plane create-app` creates the App and fills these in.
# By hand: Permissions Contents read, Pull requests read, Metadata read, Checks read/write;
# events push and check_run (installation events are always delivered).
GITHUB_APP_ID=
# URL slug of the app, e.g. "agentic-qa-fleet". Used to build the install link.
GITHUB_APP_SLUG=
# Either paste the PEM with literal "\n" for newlines...
GITHUB_PRIVATE_KEY=
# ...or point at the downloaded .pem file.
GITHUB_PRIVATE_KEY_PATH=
# Random string you set on the app's webhook settings page.
GITHUB_WEBHOOK_SECRET=
# Leave as-is for github.com. For GHES: https://ghes.example.com/api/v3
GITHUB_API_BASE_URL=https://api.github.com

# --- Local dev ---
# smee.io channel that relays webhooks to this machine. `create-app` fills it in;
# `pnpm --filter @qa-agent/control-plane tunnel` forwards it to /webhooks/github.
SMEE_URL=
# Enables POST /dev/seed, which loads fixtures straight into the in-memory store
# (`pnpm --filter @qa-agent/web seed`). Never enable outside local dev.
# Seeding needs no real GitHub App: placeholder GITHUB_APP_ID, GITHUB_WEBHOOK_SECRET
# and GITHUB_PRIVATE_KEY (e.g. 1 / dev / dummy) are enough to boot. Anything that
# calls GitHub (push runs, POST /api/runs, check runs) will fail and log.
DEV_SEED=false

# --- Web UI ---
# Base URL of the web package; used for "view run" links in checks and Slack.
WEB_URL=http://localhost:3000

# --- Slack (optional; disabled when SLACK_BOT_TOKEN is unset) ---
# Outbound only: posts a report to the channel when a run finishes. No public
# URL needed. Create the app from slack-app-manifest.json at
# https://api.slack.com/apps ("From a manifest"), install it to the workspace,
# then invite the bot to the channel below.
SLACK_BOT_TOKEN=
# Channel that receives run reports (C0123456789).
SLACK_CHANNEL_ID=
# --- Orchestrator + agent fleet (enabled when ANTHROPIC_API_KEY is set) ---
# Runs agents in-process on run.started: assembles a ContextBundle per agent,
# drives Playwright (run `pnpm --filter @qa-agent/agent install-browsers` once),
# triages, and completes the run. Without a key, runs stay "queued" until
# POST /api/runs/:id/complete. Force off with ORCHESTRATOR_ENABLED=false.
ANTHROPIC_API_KEY=
# Only for org-level keys not scoped to a workspace (the API then demands an
# anthropic-workspace-id header). Workspace-scoped keys don't need this.
ANTHROPIC_WORKSPACE_ID=
# Model id for agents (default claude-sonnet-4-6). ANTHROPIC_BASE_URL for gateways.
AGENT_MODEL=
# Agents (Chromium instances) in flight at once. Default 4.
FLEET_CONCURRENCY=4
# Wall-clock budget per agent in seconds. Default 600.
AGENT_BUDGET_SECONDS=600
# Cap on stage.fleetSize for cost control; 0 = no cap. Default 8.
MAX_FLEET_SIZE=8
# Agents in a row that must cover a surface without new findings before later
# waves are steered away from it. Default 2.
SATURATION_THRESHOLD=2
# Comma-separated hosts, path prefixes or URL substrings agents must never hit
# (requests are blocked in the browser). Per-stage config is a next step.
AGENT_BLAST_RADIUS=/admin
# Set to false to watch the browsers. Default true.
AGENT_HEADLESS=true
# Tool-call ceiling per agent. Default 150.
AGENT_MAX_STEPS=150
# Record a .webm of each agent session (a few MB per agent; local disk for now).
# Paths are logged per agent and stored on AgentResult.videoPath.
AGENT_RECORD_VIDEO=false
