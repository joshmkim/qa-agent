# --- Server ---
PORT=3001

# --- Storage ---
# Postgres from `pnpm db:up` (repo root). Unset = in-memory store, lost on every restart.
DATABASE_URL=postgres://qa:qa@localhost:5433/qa_agent
# Used by `pnpm --filter @qa-agent/control-plane test` for the Postgres half of the store tests.
TEST_DATABASE_URL=postgres://qa:qa@localhost:5433/qa_agent_test
# Public base URL of this service (used for check run details_url links).
PUBLIC_URL=http://localhost:3001

# --- GitHub App ---
# Easiest: `pnpm --filter @qa-agent/control-plane create-app` creates the App and fills these in.
# By hand: Permissions Contents read, Pull requests read, Metadata read, Checks read/write;
# events push and check_run (installation events are always delivered).
GITHUB_APP_ID=
# URL slug of the app, e.g. "agentic-qa-fleet". Used to build the install link.
GITHUB_APP_SLUG=
# Either paste the PEM with literal "\n" for newlines...
GITHUB_PRIVATE_KEY=
# ...or point at the downloaded .pem file.
GITHUB_PRIVATE_KEY_PATH=
# Random string you set on the app's webhook settings page.
GITHUB_WEBHOOK_SECRET=
# Leave as-is for github.com. For GHES: https://ghes.example.com/api/v3
GITHUB_API_BASE_URL=https://api.github.com

# --- Local dev ---
# smee.io channel that relays webhooks to this machine. `create-app` fills it in;
# `pnpm --filter @qa-agent/control-plane tunnel` forwards it to /webhooks/github.
SMEE_URL=
# Enables POST /dev/seed, which loads fixtures straight into the in-memory store
# (`pnpm --filter @qa-agent/web seed`). Never enable outside local dev.
# Seeding needs no real GitHub App: placeholder GITHUB_APP_ID, GITHUB_WEBHOOK_SECRET
# and GITHUB_PRIVATE_KEY (e.g. 1 / dev / dummy) are enough to boot. Anything that
# calls GitHub (push runs, POST /api/runs, check runs) will fail and log.
DEV_SEED=false

# --- Web UI ---
# Base URL of the web package; used for "view run" links in checks and Slack.
WEB_URL=http://localhost:3000

# --- Slack (optional; disabled when SLACK_BOT_TOKEN is unset) ---
# Outbound only: posts a report to the channel when a run finishes. No public
# URL needed. Create the app from slack-app-manifest.json at
# https://api.slack.com/apps ("From a manifest"), install it to the workspace,
# then invite the bot to the channel below.
SLACK_BOT_TOKEN=
# Channel that receives run reports (C0123456789).
SLACK_CHANNEL_ID=

# --- Jira (optional; disabled when JIRA_BASE_URL is unset) ---
# Outbound only: files triaged findings as issues when a run finishes, and
# reads issue keys out of PRs and commits. No public URL needed.
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# See jira-next-steps.md for the full setup.
JIRA_BASE_URL=
# Atlassian account email; paired with the token as HTTP Basic auth.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Project findings are filed into, e.g. QA.
JIRA_PROJECT_KEY=
# Issue type on that project's create screen. Free team-managed projects often
# ship without "Bug"; check the project or use "Task".
JIRA_ISSUE_TYPE=Bug
# Extra project prefixes to recognise in PR titles, bodies and commit messages
# (comma-separated). JIRA_PROJECT_KEY is always included.
JIRA_PROJECT_KEYS=
# Least severe finding that gets filed: P0, P1, P2 or P3.
JIRA_MIN_SEVERITY=P1
